# Copy this file to .env and fill in what you need.

PORT=4000
DATA_DIR=./data
NODE_ENV=development

# Required in production — signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this logs everyone out (all existing sessions stop verifying).
SESSION_SECRET=

# Set to true only if you intend this deployment to be open to public
# signup. Forces the phone module to the mock provider regardless of any
# Twilio credentials below, so anonymous strangers can never provision real
# numbers billed to your account. Leave unset/false for personal use.
PUBLIC_SIGNUP=false

RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_15MIN=20
CREATION_RATE_LIMIT_PER_HOUR=30

# --- Email provider ---
# Uses the free public mail.tm API by default; no credentials needed.
# Override only if you're pointing at a self-hosted mail.tm-compatible instance.
MAILTM_API_BASE=https://api.mail.tm

# --- Phone provider (optional) ---
# Leave blank to use the mock phone provider (fake numbers, canned SMS).
# Fill both in to use real Twilio numbers billed to YOUR Twilio account.
# Ignored entirely when PUBLIC_SIGNUP=true (see above).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
